# ==============================================================================
# PARKEASE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your production .env file to public version control.
# ==============================================================================

# Core Django Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# ==============================================================================
# EMAIL SERVICE & SMTP CONFIGURATION (Gmail / Custom SMTP)
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Host sender credentials (e.g. Gmail App Password)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=ParkEase <your-email@gmail.com>
SERVER_EMAIL=your-email@gmail.com

# Platform Administrator Contact Email
ADMIN_EMAIL=your-admin-email@gmail.com
OWNER_DEFAULT_EMAIL=your-owner-email@gmail.com
USER_DEFAULT_EMAIL=your-user-email@gmail.com

# ==============================================================================
# PAYMENT GATEWAY (Razorpay Official)
# Get free Test keys from https://dashboard.razorpay.com/ (Account & Settings -> API Keys)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret

# Optional Legacy / Alternate Gateway Fallbacks
PAYPAL_CLIENT_ID=sb
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

CASHFREE_APP_ID=TEST10000001
CASHFREE_SECRET_KEY=TEST_SECRET_KEY
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# ==============================================================================
# GOOGLE MAPS PLATFORM APIS
# Get keys from Google Cloud Console (https://console.cloud.google.com/google/maps-apis)
# ==============================================================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
GOOGLE_ROUTES_API_KEY=your-google-routes-api-key-here
